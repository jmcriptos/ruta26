{
  "description": "Story 1.5 — resumen post-partido (PD5).",
  "cases": [
    {
      "name": "subió y pasó a rivales (passed_friend)",
      "snapshot": { "meId": "u1" },
      "before": [
        { "userId": "u0", "username": "lider", "pos": 1, "points": 10 },
        { "userId": "u2", "username": "beto", "pos": 2, "points": 8 },
        { "userId": "u1", "username": "ana", "pos": 3, "points": 5 }
      ],
      "after": [
        { "userId": "u1", "username": "ana", "pos": 1, "points": 12 },
        { "userId": "u0", "username": "lider", "pos": 2, "points": 10 },
        { "userId": "u2", "username": "beto", "pos": 3, "points": 8 }
      ],
      "expect": { "state": "moved", "movement": "passed_friend", "posDelta": 2, "passedFirst": "lider" }
    },
    {
      "name": "lo pasó un amigo (passed_by_friend)",
      "snapshot": { "meId": "u1" },
      "before": [
        { "userId": "u1", "username": "ana", "pos": 1, "points": 5 },
        { "userId": "u2", "username": "beto", "pos": 2, "points": 4 }
      ],
      "after": [
        { "userId": "u2", "username": "beto", "pos": 1, "points": 7 },
        { "userId": "u1", "username": "ana", "pos": 2, "points": 5 }
      ],
      "expect": { "state": "moved", "movement": "passed_by_friend", "posDelta": -1, "passedByFirst": "beto" }
    },
    {
      "name": "sin movimiento relevante → null",
      "snapshot": { "meId": "u1" },
      "before": [{ "userId": "u1", "username": "ana", "pos": 1, "points": 5 }],
      "after": [{ "userId": "u1", "username": "ana", "pos": 1, "points": 5 }],
      "expect": { "null": true }
    }
  ]
}
